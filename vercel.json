{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "api/index.py": {
      "maxDuration": 120,
      "memory": 1024,
      "includeFiles": "{backend/src/**,agent/workspace/.claude/skills/**,data/recorded_runs.jsonl}",
      "excludeFiles": "{frontend/**,reports/**,examples/**,backend/tests/**,backend/scripts/**,docs/**,runs/**,**/__pycache__/**}"
    }
  }
}
